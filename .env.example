# MCP server (HTTP mode)
PORT=3000
HOST=0.0.0.0
MCP_TRANSPORT=http
# Strongly recommended on a public host. Clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=change-me
# Comma-separated browser origins allowed to call /mcp (leave empty to block all browser origins)
ALLOWED_ORIGINS=

# Video editor
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
